NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174

MONGO_URI=mongodb://127.0.0.1:27017/hospital_db

JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_REQUESTS=20

MAX_FILE_UPLOAD_MB=5
UPLOAD_DIR=uploads

# Appointment rules
HOSPITAL_TIMEZONE=Asia/Kolkata
BOOKING_WINDOW_DAYS=60
CANCELLATION_CUTOFF_HOURS=2
